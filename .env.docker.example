# NOTE FILE: .env.docker.example
# Đây là file gì: File mã nguồn/cấu hình phục vụ quá trình chạy, kiểm thử hoặc triển khai back-end.
# Mục đích note: mô tả vai trò file cấu hình/script, không note rải vào từng khai báo.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=REPLACE_DB_NAME
DB_USER=REPLACE_DB_USER
DB_PASSWORD=REPLACE_DB_PASSWORD

APP_JWT_SECRET=REPLACE_WITH_BASE64_SECRET

OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_OUTPUT_TOKENS=700
