{
  "openapi": "3.0.3",
  "info": {
    "title": "AITASKER Backend API",
    "version": "1.2.0"
  },
  "servers": [
    { "url": "http://localhost:8080" }
  ],
  "tags": [
    { "name": "Auth" },
    { "name": "Profile" },
    { "name": "Marketplace" },
    { "name": "ContractExecution" },
    { "name": "Admin" }
  ],
  "paths": {
    "/api/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Register",
        "responses": { "200": { "description": "OK" }, "409": { "description": "Conflict" } }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Login",
        "responses": { "200": { "description": "OK" }, "401": { "description": "Unauthorized" } }
      }
    },
    "/api/v1/profiles/business": {
      "post": { "tags": ["Profile"], "summary": "Upsert business profile", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "OK" } } },
      "get": { "tags": ["Profile"], "summary": "List business profiles", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "OK" } } }
    },
    "/api/v1/profiles/expert": {
      "post": { "tags": ["Profile"], "summary": "Upsert expert profile", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "OK" } } },
      "get": { "tags": ["Profile"], "summary": "List expert profiles", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "OK" } } }
    },
    "/api/v1/profiles/expert/portfolio-file": {
      "post": { "tags": ["Profile"], "summary": "Upload expert portfolio file", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "OK" } } }
    },
    "/api/v1/profiles/portfolio": {
      "post": { "tags": ["Profile"], "summary": "Upsert portfolio", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "OK" } } },
      "get": { "tags": ["Profile"], "summary": "List portfolios", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "OK" } } }
    },
    "/api/v1/profiles/approve/{type}/{id}": {
      "post": {
        "tags": ["Profile"],
        "summary": "Approve profile",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "type", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "status", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "reason", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/v1/jobs": {
      "post": { "tags": ["Marketplace"], "summary": "Create job", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "OK" } } },
      "get": { "tags": ["Marketplace"], "summary": "List jobs", "responses": { "200": { "description": "OK" } } }
    },
    "/api/v1/jobs/{jobId}": {
      "get": {
        "tags": ["Marketplace"],
        "summary": "Get job detail",
        "parameters": [{ "name": "jobId", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "OK" }, "404": { "description": "Not Found" } }
      }
    },
    "/api/v1/jobs/{jobId}/status": {
      "patch": {
        "tags": ["Marketplace"],
        "summary": "Update job status",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "jobId", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "status", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    },
