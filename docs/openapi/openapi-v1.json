      "post": {
        "tags": ["ContractExecution"],
        "summary": "Record demo testing result",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "disputeId", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "testResult", "in": "query", "required": true, "schema": { "type": "string" } }
