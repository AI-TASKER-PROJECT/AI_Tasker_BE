      "post": { "tags": ["Marketplace"], "summary": "Submit proposal", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "OK" }, "409": { "description": "Conflict" } } }
    },
    "/api/v1/proposals/{proposalId}/status": {
      "patch": {
        "tags": ["Marketplace"],
        "summary": "Review proposal",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "proposalId", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "status", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    },
