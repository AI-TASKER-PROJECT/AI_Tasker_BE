          { "name": "disputeId", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "reportContent", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "proposedAction", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/v1/milestones/sla-auto-approve": {
      "post": {
        "tags": ["ContractExecution"],
        "summary": "Run SLA auto approve milestones",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/v1/jobs/{jobId}/matching": {
      "get": {
        "tags": ["ContractExecution"],
        "summary": "Matching by keyword",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "jobId", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/v1/admin/reviews": {
      "post": {
        "tags": ["Admin"],
        "summary": "Create review",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/v1/admin/reviews/contracts/{contractId}": {
      "get": {
        "tags": ["Admin"],
        "summary": "List reviews by contract",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "contractId", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/v1/admin/settings": {
      "get": {
        "tags": ["Admin"],
        "summary": "List system settings",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/v1/admin/settings/{key}": {
      "patch": {
        "tags": ["Admin"],
        "summary": "Update system setting",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "key", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "value", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "isActive", "in": "query", "required": false, "schema": { "type": "boolean" } }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/v1/admin/staffs": {
      "get": {
        "tags": ["Admin"],
        "summary": "List staffs",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "OK" } }
      },
      "post": {
        "tags": ["Admin"],
        "summary": "Create staff",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/v1/admin/analytics/overview": {
      "get": {
        "tags": ["Admin"],
        "summary": "Analytics overview",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "OK" } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
