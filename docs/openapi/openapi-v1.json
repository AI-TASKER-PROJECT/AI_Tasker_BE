          { "name": "transactionId", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } },
          { "name": "status", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/v1/transactions/{transactionId}/webhook": {
      "post": {
        "tags": ["ContractExecution"],
        "summary": "Process payment webhook",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "transactionId", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } },
          { "name": "paymentStatus", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "bankTxCode", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "receiptImgUrl", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/v1/invoices": {
      "post": { "tags": ["ContractExecution"], "summary": "Create invoice", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "OK" } } }
    },
    "/api/v1/disputes": {
      "post": { "tags": ["ContractExecution"], "summary": "Create dispute", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "OK" } } }
    },
