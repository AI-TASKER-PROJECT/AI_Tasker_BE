      "post": {
        "tags": ["ContractExecution"],
        "summary": "Create draft contract from proposal",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "proposalId", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/v1/contracts/change-requests": {
      "post": { "tags": ["ContractExecution"], "summary": "Create contract change request", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "OK" } } }
    },
    "/api/v1/contracts/{contractId}/sign": {
      "post": {
        "tags": ["ContractExecution"],
        "summary": "Sign contract",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "contractId", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/v1/contracts/{contractId}/nda-sign": {
      "post": {
        "tags": ["ContractExecution"],
        "summary": "Sign NDA for active contract",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "contractId", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/v1/contracts/{contractId}/terminate": {
      "post": {
        "tags": ["ContractExecution"],
        "summary": "Terminate contract",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "contractId", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "reason", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    },
