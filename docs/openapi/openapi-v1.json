          { "name": "disputeId", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "staffId", "in": "query", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/v1/disputes/{disputeId}/resolve": {
      "patch": {
        "tags": ["ContractExecution"],
        "summary": "Resolve dispute",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "disputeId", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "proposedAction", "in": "query", "required": true, "schema": { "type": "string" } }
