      "post": { "tags": ["ContractExecution"], "summary": "Create acceptance criteria", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "OK" } } }
    },
    "/api/v1/milestones/{milestoneId}/criteria": {
      "get": {
        "tags": ["ContractExecution"],
        "summary": "List criteria by milestone",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "milestoneId", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "OK" } }
      }
    },
