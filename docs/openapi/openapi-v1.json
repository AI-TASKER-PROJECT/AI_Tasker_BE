      "get": {
        "tags": ["Marketplace"],
        "summary": "List proposals by job",
        "parameters": [{ "name": "jobId", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "OK" } }
      }
    },
