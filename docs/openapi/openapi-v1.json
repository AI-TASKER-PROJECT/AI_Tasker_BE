      "get": {
        "tags": ["ContractExecution"],
        "summary": "List milestones by contract",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "contractId", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "OK" } }
      }
    },
